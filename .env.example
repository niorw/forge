# ============================================================
# Forge 环境变量配置示例
# 
# 使用方式:
#   1. 开发环境: 复制此文件为 application-local.yml 放到 src/main/resources/
#   2. 生产环境: 设置系统环境变量或使用 .env 文件
# ============================================================

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=forge
DB_USER=root
DB_PASSWORD=your_p...n
# Redis 集群（逗号分隔的 host:port）
REDIS_NODES=host1:7000,host2:7001,host3:7002
# Redis 密码（可选）
REDIS_PASSWORD=

# Anthropic API
ANTHROPIC_API_KEY=your_a...n
# OpenAI API
OPENAI_API_KEY=your_o...n

# Agent 模型配置（可选）
PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-sonnet-4-20250514
REVIEWER_PROVIDER=anthropic
REVIEWER_MODEL=claude-sonnet-4-20250514
CODER_PROVIDER=openai
CODER_MODEL=gpt-4o
